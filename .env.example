# ── AWS / Bedrock ────────────────────────────────────────────────
AWS_REGION=us-east-1
# Leave blank to use the default AWS credential chain (env, profile, SSO, role)
AWS_PROFILE=

# Bedrock model IDs
BEDROCK_LLM_MODEL_ID=us.amazon.nova-2-lite-v1:0
BEDROCK_EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBED_DIM=1024

# ── Vector store ─────────────────────────────────────────────────
# "s3vectors" to use Amazon S3 Vectors, or "local" for the JSON/numpy fallback
VECTOR_BACKEND=local

# S3 Vectors settings (only used when VECTOR_BACKEND=s3vectors)
S3_VECTOR_BUCKET=devonboarding-rag
S3_VECTOR_INDEX=knowledge-base

# Local fallback store path
LOCAL_STORE_PATH=data/vector_store.json

# ── Retrieval / generation ───────────────────────────────────────
RETRIEVAL_TOP_K=5
CHUNK_SIZE=1200
CHUNK_OVERLAP=150
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1024

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
